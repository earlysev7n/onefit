rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile + all subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /food_logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /meal_plans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /workout_plans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /workout_logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /weight_logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /weekly_summaries/{weekId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Exercise cache — readable by all authenticated users, writable for caching
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Ingredient cache (kept for backwards compatibility)
    match /ingredients/{ingredientId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
